<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="0dp"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_window"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left Side: Image from URL placeholder / ImageView -->
        <com.redystum.andala.ui.components.RoundedImageView
            android:id="@+id/info_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_popup_image"
            android:clipToOutline="true"
            android:contentDescription="Pousada Image"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <!-- Right Side: All Text and Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Close Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/info_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/popup_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:contentDescription="Close"
                    android:focusable="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/anda_pink" />
            </RelativeLayout>

            <!-- Snippet / Location -->
            <TextView
                android:id="@+id/info_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/popup_on_surface_variant"
                android:textSize="12sp" />

            <!-- Action Button -->
            <Button
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_popup_button_unselected"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Selecionar"
                android:textColor="@color/anda_pink"
                android:textSize="11sp"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

    <!-- Speech Bubble Arrow Pointing Down -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/linearLayout"
        android:layout_alignParentStart="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="0dp"
        android:contentDescription="Arrow pointer"
        android:src="@drawable/ic_popup_arrow" />
</RelativeLayout>
